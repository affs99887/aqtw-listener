<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AqtwListener</AssemblyName>
    <Title>行商助手</Title>
    <AssemblyTitle>行商助手</AssemblyTitle>
    <Product>行商助手</Product>
    <Description>行商助手 · 物品音效识别与同音候选浮窗</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/listener.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/listener-mark.png" />
    <Resource Include="Assets/listener-app.png" />
    <Resource Include="Assets/listener.ico" />
    <InternalsVisibleTo Include="Listener.App.Tests" />
    <ProjectReference Include="../Listener.Core/Listener.Core.csproj" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <Content Include="../../data/library/**/*" Link="library/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/**/*" Link="docs/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
